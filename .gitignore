# VCF compound layer — pipeline output, tracked in git.
# 2026-08-30: reviewed and lifted the blanket exclude — these artifacts are
# load-bearing at runtime, not purely derived/rebuildable (see meta.json,
# which is the pipeline's audit trail and needs version history).
# The two large intermediate tables are excluded pending Git LFS or a
# documented regeneration step: each is a single ~25-30MB file that churns
# heavily on every rebuild.
pipeline/artifacts/vcf/quantities.jsonl
pipeline/artifacts/vcf/form_diffs.jsonl

# 2026-08-30: src/full_dataset.csv is 166.5MB — over GitHub's HARD 100MB
# per-file cap, a push containing it is rejected outright, not just warned.
# Local-only (symlink or real file). Never commit the blob.
src/full_dataset.csv

# Local demo zip extract scratch; never commit
.demo_import/

# Riverside Vite build output (root `dist` already ignored; keep explicit)
riverside/dist/

# Founder dump zips — extract needed artifacts only; never commit the archive
/ChefCulin*.zip
/*.zip
/Latest_Demo.zip

# Vite build cruft, should never have been sitting in the working tree
vite.config.js.timestamp-*.mjs

# setuptools build metadata — regenerated by `pip install -e .`, machine-specific
pipeline/culin_etl.egg-info/

# stale one-off gzip snapshot, 2026-08-30 00:57 — predates today's rebuilds and
